# =============================================================================
# Vitalis — Clinical Intelligence MCP Server
# Complete environment reference (BUILD_PLAN.md §9.1). Copy to .env and fill in.
# =============================================================================

# Runtime / transport
NODE_ENV=development
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal
# MCP_TRANSPORT_TYPE: stdio | http | dual.
# Defaults: stdio in development, dual when NODE_ENV=production.
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost            # set 0.0.0.0 in production
# ENABLE_CORS=true

# -----------------------------------------------------------------------------
# Auth (§5.1). Guards enforce these; the server boots without them so
# anonymous-demo mode and local dev stay possible.
# -----------------------------------------------------------------------------
# Full read/write scopes (triage, drugs, dx, research, fhir, care:read+write)
API_KEY_CLINICIAN=vk_live_clinician_demo_key_01
# Read scopes only (triage, drugs, dx, research, fhir)
API_KEY_READONLY=vk_live_readonly_demo_key_02
# All scopes + admin:audit
API_KEY_ADMIN=vk_live_admin_demo_key_03
# When true, requests without a key get read-only scopes (for judges)
VITALIS_ALLOW_ANONYMOUS_DEMO=false
# OAuth 2.1 / JWT upgrade (stretch goal S1)
# JWT_SECRET=

# -----------------------------------------------------------------------------
# Upstream APIs (§4.1 — defaults are the live public endpoints, verified)
# -----------------------------------------------------------------------------
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST
RXCLASS_BASE_URL=https://rxnav.nlm.nih.gov/REST/rxclass
CLINTABLES_BASE_URL=https://clinicaltables.nlm.nih.gov/api

OPENFDA_BASE_URL=https://api.fda.gov
# Free key at https://open.fda.gov/apis/authentication/ (240 req/min, 120k/day vs 1000/day anon)
# OPENFDA_API_KEY=

NCBI_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
# NCBI etiquette: always send tool + email; key raises limit 3 -> 10 req/s
# NCBI_API_KEY=
NCBI_EMAIL=you@example.com

TRIALS_BASE_URL=https://clinicaltrials.gov/api/v2

# FHIR R4 — synthetic Synthea patients only (public test servers)
FHIR_BASE_URL=https://hapi.fhir.org/baseR4
FHIR_BASE_URL_FALLBACK=https://r4.smarthealthit.org

# Optional WHO ICD-11 upgrade (free registration at https://icd.who.int/icdapi)
# ICD_CLIENT_ID=
# ICD_CLIENT_SECRET=
# ICD_BASE_URL=https://id.who.int/icd

# -----------------------------------------------------------------------------
# Safety + ops
# -----------------------------------------------------------------------------
# 'off' disables ONLY the output-rewriting interceptor (demo comparison mode);
# emergency pre-checks always run. Boot prints a loud warning when off.
VITALIS_SAFETY_LAYER=on
AUDIT_LOG_PATH=logs/audit.jsonl
CONTACT_EMAIL=you@example.com
